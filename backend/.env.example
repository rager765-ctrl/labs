# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for multiple origins)
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Firebase Configuration
FIREBASE_PROJECT_ID=attendance-9a7f5

# --- FIREBASE CREDENTIALS (CHOOSE ONE OPTION BELOW) ---
#
# OPTION 1 (Recommended for Render):
# Paste the entire content of your Firebase Service Account JSON file as a single line string:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"attendance-9a7f5",...}
FIREBASE_SERVICE_ACCOUNT_KEY=

# OPTION 2: Separate environment variables
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@attendance-9a7f5.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...=\n-----END PRIVATE KEY-----\n"

# OPTION 3 (Local Development only):
# Put your downloaded serviceAccountKey.json inside the backend/ folder:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
